generator client {
  provider = "prisma-client-js"
  // 显式输出到前端项目的 node_modules，保证 prisma generate / db:push
  // 更新的 client 与 Next.js 应用实际解析到的副本一致
  output = "../../front/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String?   @unique
  passwordHash  String
  displayName   String?
  avatar        String?
  isActive      Boolean   @default(true)
  isSuperAdmin  Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userRoles UserRole[]
  novels    Novel[]

  @@index([username])
  @@index([isActive])
}

model Role {
  id          String    @id @default(cuid())
  name        String    @unique
  code        String    @unique
  description String?
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userRoles     UserRole[]
  rolePerms     RolePermission[]
  roleMenus     RoleMenu[]

  @@index([code])
}

model Permission {
  id          String    @id @default(cuid())
  name        String    @unique
  code        String    @unique
  module      String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  rolePerms RolePermission[]

  @@index([code])
  @@index([module])
}

model Menu {
  id          String   @id @default(cuid())
  parentId    String?
  name        String
  path        String?
  icon        String?
  sort        Int      @default(0)
  isVisible   Boolean  @default(true)
  permissionCode String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent    Menu?      @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Menu[]     @relation("MenuTree")
  roleMenus RoleMenu[]

  @@index([parentId])
  @@index([sort])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RoleMenu {
  roleId String
  menuId String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@id([roleId, menuId])
}

model NewsArticle {
  id           String   @id @default(cuid())
  title        String
  summary      String?
  url          String   @unique
  source       String
  publishedAt  DateTime?
  createdAt    DateTime @default(now())

  @@index([source])
  @@index([publishedAt])
  @@index([createdAt])
}

model Novel {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  genre       String
  cover       String?
  wordCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  worldSetting WorldSetting?
  characters   Character[]
  relations    CharacterRelation[]
  chapters     Chapter[]

  @@index([userId])
}

model WorldSetting {
  id         String   @id @default(cuid())
  novelId    String   @unique
  background String   @default("")
  timeline   String   @default("")
  geography  String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)
}

model Character {
  id          String   @id @default(cuid())
  novelId     String
  name        String
  avatar      String?
  personality String?
  background  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  novel           Novel               @relation(fields: [novelId], references: [id], onDelete: Cascade)
  fromRelations   CharacterRelation[] @relation("FromCharacter")
  toRelations     CharacterRelation[] @relation("ToCharacter")

  @@index([novelId])
}

model CharacterRelation {
  id              String   @id @default(cuid())
  novelId         String
  fromCharacterId String
  toCharacterId   String
  label           String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  novel        Novel     @relation(fields: [novelId], references: [id], onDelete: Cascade)
  fromCharacter Character @relation("FromCharacter", fields: [fromCharacterId], references: [id], onDelete: Cascade)
  toCharacter   Character @relation("ToCharacter", fields: [toCharacterId], references: [id], onDelete: Cascade)

  @@index([novelId])
}

model Chapter {
  id        String   @id @default(cuid())
  novelId   String
  title     String
  summary   String?
  content   Json?
  text      String?
  wordCount Int      @default(0)
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId, sort])
}
