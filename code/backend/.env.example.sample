# 安全配置示例模板 (不包含真实凭证)

# 数据库配置 (Docker内部端口5432)
DATABASE_URL="postgresql://hugoai:your-db-password-here@localhost:5432/hugoai?schema=public"

# Redis 配置 (Docker内部端口6379)
REDIS_URL="redis://localhost:6379"

# AI 模型配置 (OpenAI 兼容接口)
# 通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek: https://api.deepseek.com/v1
# Kimi: https://api.moonshot.cn/v1
AI_API_BASE_URL="https://api.example.com/v1"
AI_API_KEY="sk-REDACTED"  # 从服务提供商获取实际密钥
AI_MODEL="gpt-4"

# JWT 配置 (生产环境必须使用强随机密钥)
JWT_SECRET="your-secure-jwt-secret-here"  # 建议使用: openssl rand -base64 32

# 应用配置
NEXT_PUBLIC_APP_NAME="HugoAI"
PORT=18867

# 安全提示:
# 1. 将此文件重命名为 .env 并填写实际值
# 2. 不要提交包含真实凭证的 .env 文件
# 3. 敏感密钥应通过环境变量或密钥管理服务注入